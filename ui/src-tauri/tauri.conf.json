{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WIS+",
  "version": "0.4.0",
  "identifier": "com.wisplus.desktop",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash ../scripts/build_sidecar.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WIS+ — W201 Workshop Information System",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "msi"],
    "externalBin": [
      "binaries/wisplus-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
